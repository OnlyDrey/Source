{{!< default}}
{{!-- Full Width Page Template --}}

{{#post}}

<main class="gh-main px-6 py-12">
    <article class="{{post_class}} max-w-6xl mx-auto">
        <header class="mb-12">
            <h1 class="text-4xl md:text-5xl font-bold mb-6">{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="text-xl text-[var(--color-text-muted)] mb-8">{{custom_excerpt}}</p>
            {{/if}}

            {{#if feature_image}}
                <figure class="rounded-lg overflow-hidden">
                    <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" class="w-full">
                    {{#if feature_image_caption}}
                        <figcaption class="text-center text-sm text-[var(--color-text-muted)] mt-2">{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{/if}}
        </header>

        <div class="gh-content">
            {{content}}
        </div>
    </article>
</main>

{{/post}}

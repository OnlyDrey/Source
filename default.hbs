<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>

    {{!-- Basic meta - advanced meta is output with {{ghost_head}} below --}}
    <title>{{meta_title}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{!-- Tailwind CSS v4 Browser Version --}}
    <script src="https://cdn.tailwindcss.com"></script>

    {{!-- Theme assets - use the {{asset}} helper to reference styles & scripts --}}
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}">
    <link rel="stylesheet" type="text/css" href="{{asset "css/custom.css"}}">

    {{!-- Theme initialization script - MUST run before body to prevent FOUC --}}
    <script>
        (function() {
            // Get stored theme or use system preference
            var storedTheme = localStorage.getItem('akio-theme');
            var systemTheme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            var theme = storedTheme || '{{@custom.color_scheme}}' || systemTheme;

            // Handle "System" option
            if (theme === 'System') {
                theme = systemTheme;
            }

            // Apply theme immediately
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    {{!-- This tag outputs all your advanced SEO meta, structured data, and other important settings --}}
    {{ghost_head}}

</head>
<body class="{{body_class}} antialiased"
      data-show-particles="{{@custom.show_particles}}"
      data-particle-count="{{@custom.particle_count}}"
      data-post-layout="{{@custom.post_layout}}"
      data-show-reading-progress="{{@custom.show_reading_progress}}"
      data-show-toc="{{@custom.show_toc}}">

{{!-- Particles Canvas for Homepage --}}
{{#is "home"}}
    <canvas id="particles-canvas"></canvas>
{{/is}}

{{!-- Reading Progress Bar for Posts --}}
{{#is "post"}}
    {{#if @custom.show_reading_progress}}
        <div id="reading-progress"></div>
    {{/if}}
{{/is}}

<div class="gh-viewport">

    {{!-- Navigation --}}
    {{> "navbar"}}

    {{!-- Main Content --}}
    {{{body}}}

    {{!-- Footer --}}
    {{> "footer"}}

</div>

{{!-- Search Modal --}}
{{> "search-modal"}}

{{#is "post, page"}}
    {{> "lightbox"}}
{{/is}}

{{!-- Scripts - load in order --}}
<script src="{{asset "built/source.js"}}"></script>
<script src="{{asset "js/particles.js"}}"></script>
<script src="{{asset "js/theme-main.js"}}"></script>

{{!-- Ghost outputs required functional scripts with this tag --}}
{{ghost_foot}}

</body>
</html>

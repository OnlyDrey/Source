{{!< default}}
{{!-- Full Width Post Template --}}

{{#post}}

<main class="gh-main px-6 py-12">
    <article class="{{post_class}}">
        {{!-- Post Header --}}
        <header class="max-w-6xl mx-auto mb-12">
            {{!-- Primary Tag --}}
            {{#if primary_tag}}
                <a href="{{primary_tag.url}}" class="inline-block px-3 py-1 text-sm font-semibold text-accent bg-accent/10 rounded-full mb-4 hover:bg-accent/20 transition-colors">
                    {{primary_tag.name}}
                </a>
            {{/if}}

            {{!-- Title --}}
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">{{title}}</h1>

            {{!-- Excerpt --}}
            {{#if custom_excerpt}}
                <p class="text-xl text-[var(--color-text-muted)] mb-8">{{custom_excerpt}}</p>
            {{/if}}

            {{!-- Meta --}}
            <div class="flex items-center gap-6 text-sm text-[var(--color-text-muted)] pb-8 border-b border-[var(--color-border)]">
                {{!-- Author Images --}}
                <div class="flex -space-x-2">
                    {{#foreach authors}}
                        {{#if profile_image}}
                            <a href="{{url}}" class="relative">
                                <img src="{{img_url profile_image size="xs"}}" alt="{{name}}" class="w-10 h-10 rounded-full border-2 border-[var(--color-bg)]">
                            </a>
                        {{/if}}
                    {{/foreach}}
                </div>

                {{!-- Author Names & Date --}}
                <div>
                    <div class="font-semibold text-[var(--color-text)]">
                        {{#foreach authors}}{{#if @first}}{{name}}{{else}}, {{name}}{{/if}}{{/foreach}}
                    </div>
                    <div class="flex items-center gap-3">
                        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                        {{#if reading_time}}
                            <span>•</span>
                            <span>{{reading_time}} min read</span>
                        {{/if}}
                    </div>
                </div>
            </div>

            {{!-- Feature Image --}}
            {{#if feature_image}}
                <figure class="mt-8 rounded-lg overflow-hidden">
                    <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" class="w-full">
                    {{#if feature_image_caption}}
                        <figcaption class="text-center text-sm text-[var(--color-text-muted)] mt-2">{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{/if}}
        </header>

        {{!-- Full Width Content --}}
        <div class="gh-content max-w-6xl mx-auto">
            {{content}}
        </div>

        {{!-- Comments --}}
        {{#if comments}}
            <div class="max-w-6xl mx-auto mt-12">
                {{comments}}
            </div>
        {{/if}}

        {{!-- Author Card --}}
        {{#if @custom.show_author_card}}
            {{#foreach authors}}
                {{#if @first}}
                    <div class="author-card max-w-6xl mx-auto">
                        {{#if profile_image}}
                            <img src="{{img_url profile_image size="m"}}" alt="{{name}}" class="author-card-image">
                        {{/if}}
                        <div class="flex-1">
                            <h3 class="author-card-name">{{name}}</h3>
                            {{#if bio}}
                                <p class="author-card-bio">{{bio}}</p>
                            {{/if}}
                            {{#if website}}
                                <a href="{{website}}" target="_blank" rel="noopener noreferrer" class="text-[var(--ghost-accent-color)] hover:underline mt-2 inline-block">
                                    Visit website
                                </a>
                            {{/if}}
                        </div>
                    </div>
                {{/if}}
            {{/foreach}}
        {{/if}}
    </article>
</main>

{{/post}}

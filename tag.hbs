{{!< default}}
{{!-- Tag Archive Template --}}

<main class="gh-main px-6 py-12">
    {{#tag}}
        <header class="max-w-4xl mx-auto text-center mb-16">
            {{#if feature_image}}
                <img src="{{img_url feature_image size="l"}}" alt="{{name}}" class="w-full h-64 object-cover rounded-lg mb-8">
            {{/if}}

            <h1 class="text-4xl md:text-5xl font-bold mb-4"># {{name}}</h1>

            {{#if description}}
                <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto">{{description}}</p>
            {{/if}}
        </header>
    {{/tag}}

    {{!-- Tag Posts --}}
    <div class="max-w-7xl mx-auto">
        <div class="post-grid-3">
            {{#foreach posts}}
                {{> "post-card"}}
            {{/foreach}}
        </div>

        {{> "pagination"}}
    </div>
</main>
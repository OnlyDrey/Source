{
    "name": "akio-source-theme",
    "description": "A highly customizable Ghost theme based on Source with particles, dark mode, and advanced features",
    "demo": "https://source.ghost.io",
    "version": "2.0.0",
    "engines": {
        "ghost": ">=5.0.0"
    },
    "license": "MIT",
    "scripts": {
        "dev": "gulp",
        "zip": "gulp zip",
        "test": "gscan .",
        "test:ci": "gscan --fatal --verbose .",
        "pretest": "gulp build",
        "preship": "yarn test",
        "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then yarn version && git push --follow-tags; else echo \"Uncomitted changes found.\" && exit 1; fi",
        "postship": "git fetch && gulp release"
    },
    "author": {
        "name": "Akio Theme",
        "email": "hello@akio-theme.com",
        "url": "https://github.com/OnlyDrey/Source"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine",
            "Photography"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme",
        "dark-mode",
        "particles",
        "customizable"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/OnlyDrey/Source.git"
    },
    "bugs": "https://github.com/OnlyDrey/Source/issues",
    "contributors": "https://github.com/OnlyDrey/Source/graphs/contributors",
    "devDependencies": {
        "@tryghost/release-utils": "0.8.1",
        "autoprefixer": "10.4.24",
        "beeper": "2.1.0",
        "cssnano": "7.1.2",
        "gscan": "5.2.4",
        "gulp": "5.0.1",
        "gulp-concat": "2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "10.0.0",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "6.1.0",
        "inquirer": "13.2.2",
        "postcss": "8.5.6",
        "postcss-easy-import": "4.0.0",
        "pump": "3.0.3"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "posts_per_page": 12,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1000
            },
            "xl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
            "navigation_layout": {
                "type": "select",
                "options": [
                    "Logo Center",
                    "Logo Left"
                ],
                "default": "Logo Center",
                "description": "Choose navigation bar layout"
            },
            "color_scheme": {
                "type": "select",
                "options": [
                    "Dark",
                    "Light",
                    "System"
                ],
                "default": "Dark",
                "description": "Choose color theme for your site"
            },
            "show_hero_title": {
                "type": "boolean",
                "default": true,
                "description": "Show site description as hero on homepage",
                "group": "homepage"
            },
            "homepage_layout": {
                "type": "select",
                "options": [
                    "Hero + Grid",
                    "Grid Only",
                    "List",
                    "Masonry"
                ],
                "default": "Hero + Grid",
                "group": "homepage",
                "description": "Choose homepage post layout"
            },
            "posts_per_row": {
                "type": "select",
                "options": [
                    "2",
                    "3",
                    "4"
                ],
                "default": "3",
                "group": "homepage",
                "description": "Number of posts per row in grid layouts"
            },
            "show_particles": {
                "type": "boolean",
                "default": true,
                "group": "homepage",
                "description": "Show animated particle background on homepage"
            },
            "particle_count": {
                "type": "select",
                "options": [
                    "50",
                    "100",
                    "150",
                    "200"
                ],
                "default": "150",
                "group": "homepage",
                "description": "Number of particles in animation",
                "visibility": "show_particles:true"
            },
            "post_layout": {
                "type": "select",
                "options": [
                    "Full Width",
                    "Narrow Center",
                    "Sidebar Right"
                ],
                "default": "Narrow Center",
                "group": "post",
                "description": "Post content layout style"
            },
            "show_reading_progress": {
                "type": "boolean",
                "default": true,
                "group": "post",
                "description": "Show reading progress bar on posts"
            },
            "show_toc": {
                "type": "boolean",
                "default": true,
                "group": "post",
                "description": "Show table of contents on posts"
            },
            "show_related_posts": {
                "type": "boolean",
                "default": true,
                "group": "post",
                "description": "Show related posts section"
            },
            "show_author_card": {
                "type": "boolean",
                "default": true,
                "group": "post",
                "description": "Show author card on posts"
            },
            "footer_text": {
                "type": "text",
                "default": "",
                "description": "Custom footer text (optional)"
            }
        }
    },
    "renovate": {
        "extends": [
            "@tryghost:theme"
        ]
    }
}

{{!< default}}
{{!-- Page Template --}}

{{#post}}

<main class="gh-main px-6 py-12">
    <article class="{{post_class}} max-w-4xl mx-auto">
        {{!-- Only show header if title and feature image are not hidden --}}
        {{#unless @page.show_title_and_feature_image}}
            {{!-- If show_title_and_feature_image is false, hide title/image --}}
        {{else}}
            <header class="mb-12">
                <h1 class="text-4xl md:text-5xl font-bold mb-6">{{title}}</h1>

                {{#if custom_excerpt}}
                    <p class="text-xl text-muted mb-8">{{custom_excerpt}}</p>
                {{/if}}

                {{!-- Page metadata --}}
                <div class="text-sm text-muted mb-8">
                    {{#if updated_at}}
                        Last updated: <time datetime="{{date updated_at format="YYYY-MM-DD"}}">{{date updated_at format="MMMM D, YYYY"}}</time>
                    {{else if published_at}}
                        Published: <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="MMMM D, YYYY"}}</time>
                    {{/if}}
                    {{#if reading_time}}
                        · {{reading_time}}
                    {{/if}}
                </div>

                {{#if feature_image}}
                    <figure class="rounded-lg overflow-hidden">
                        <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" class="w-full">
                        {{#if feature_image_caption}}
                            <figcaption class="text-center text-sm text-muted mt-2">{{feature_image_caption}}</figcaption>
                        {{/if}}
                    </figure>
                {{/if}}
            </header>
        {{/unless}}

        <div class="gh-content">
            {{content}}
        </div>

        {{!-- Comments --}}
        {{#if comments}}
            <div class="gh-comments mt-16 pt-8 border-t border-color">
                {{comments}}
            </div>
        {{/if}}

        {{!-- CTA for members --}}
        {{#if @site.members_enabled}}
            {{#unless @member}}
                <div class="mt-16 pt-8 border-t border-color text-center">
                    <h3 class="text-2xl font-bold mb-4">{{@site.title}}</h3>
                    <p class="text-muted mb-6">{{@site.description}}</p>
                    {{> "newsletter-form"}}
                </div>
            {{/unless}}
        {{/if}}
    </article>
</main>

{{/post}}
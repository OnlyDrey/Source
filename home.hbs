{{!< default}}
{{!-- Fallback homepage (index.hbs takes precedence) --}}

<main class="gh-main px-6 py-12">
    <div class="max-w-7xl mx-auto">
        {{#if @custom.show_hero_title}}
            <header class="text-center mb-12">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">
                    {{#if @site.description}}
                        {{@site.description}}
                    {{else}}
                        {{@site.title}}
                    {{/if}}
                </h1>
            </header>
        {{/if}}

        <div class="post-grid-{{@custom.posts_per_row}}">
            {{#foreach posts}}
                {{> "post-card"}}
            {{/foreach}}
        </div>

        {{> "pagination"}}
    </div>
</main>
{{!-- Post Card for List Layout --}}
<article class="post-card {{post_class}} flex flex-col md:flex-row gap-6 group">
    {{#if feature_image}}
        <a href="{{url}}" class="md:w-1/3 overflow-hidden rounded-lg flex-shrink-0">
            <img
                srcset="{{img_url feature_image size="xs" format="webp"}} 100w,
                        {{img_url feature_image size="s" format="webp"}} 300w,
                        {{img_url feature_image size="m" format="webp"}} 600w"
                sizes="(max-width: 768px) 100vw, 400px"
                src="{{img_url feature_image size="m"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                class="w-full h-48 md:h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
            >
        </a>
    {{/if}}

    <div class="flex-1 post-card-content p-0">
        {{!-- Primary Tag --}}
        {{#if primary_tag}}
            <a href="{{primary_tag.url}}" class="inline-block px-3 py-1 text-xs font-semibold text-accent bg-accent/10 rounded-full mb-3 hover:bg-accent/20 transition-colors">
                {{primary_tag.name}}
            </a>
        {{/if}}

        {{!-- Title --}}
        <h2 class="text-2xl font-bold mb-3">
            <a href="{{url}}" class="text-[var(--color-text)] hover:text-[var(--ghost-accent-color)] transition-colors">
                {{title}}
            </a>
        </h2>

        {{!-- Excerpt --}}
        {{#if custom_excerpt}}
            <p class="text-[var(--color-text-muted)] mb-4 line-clamp-3">{{custom_excerpt}}</p>
        {{else if excerpt}}
            <p class="text-[var(--color-text-muted)] mb-4 line-clamp-3">{{excerpt}}</p>
        {{/if}}

        {{!-- Meta --}}
        <div class="flex items-center gap-4 text-sm text-[var(--color-text-muted)]">
            {{!-- Lock icon for non-public posts --}}
            {{^has visibility="public"}}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
            {{/has}}

            {{!-- Author --}}
            {{#foreach authors}}
                {{#if @first}}
                    <span>{{name}}</span>
                {{/if}}
            {{/foreach}}

            {{!-- Date --}}
            <time datetime="{{date format="YYYY-MM-DD"}}">
                {{date format="DD MMM YYYY"}}
            </time>

            {{!-- Reading time --}}
            {{#if reading_time}}
                <span>{{reading_time}} min read</span>
            {{/if}}
        </div>

        {{!-- Read More Link --}}
        <a href="{{url}}" class="inline-flex items-center mt-4 text-[var(--ghost-accent-color)] hover:underline font-semibold">
            Read more
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </a>
    </div>
</article>
